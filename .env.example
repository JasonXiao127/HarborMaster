# Copy to .env and adjust. Never commit .env with secrets.
# APP_HOST_PORT must be IP:PORT — a bare "5000" listens on all interfaces.
APP_HOST_PORT=127.0.0.1:5000
# APP_PORT is the container port (host side comes from APP_HOST_PORT).
APP_PORT=5000
DOCKER_TIMEOUT=5
STATS_TIMEOUT=5
ACTION_TIMEOUT=10
# Set to require token auth on /api/* (X-Auth-Token header or
# Authorization: Bearer <token>). Empty = open (warns in logs).
# The web UI forwards ?token=<token> from the page URL as a header,
# so bookmarking a token URL works without leaking it to the API.
MONITOR_AUTH_TOKEN=
