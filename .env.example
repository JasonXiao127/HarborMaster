# Copy to .env and adjust. Never commit .env with secrets.
# APP_HOST_PORT must be IP:PORT — a bare "5000" listens on all interfaces.
APP_HOST_PORT=127.0.0.1:5000
DOCKER_TIMEOUT=5
STATS_TIMEOUT=5
# Set to require token auth on /api/* (header X-Auth-Token or ?token=).
# Empty = open (legacy homelab behavior, warns in logs).
MONITOR_AUTH_TOKEN=
